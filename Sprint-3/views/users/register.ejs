<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 500px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Acceso Privado</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 20px 0; font-weight: normal;">Únete al distrito.</h2>
            
            <div style="display: flex; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                <a href="/login" style="color: var(--text-muted); text-decoration: none;">INICIAR SESIÓN</a>
                <span style="font-weight: bold; border-bottom: 2px solid var(--bg-red); padding-bottom: 11px;">REGÍSTRATE</span>
            </div>

            <form onsubmit="event.preventDefault(); alert('¡Cuenta creada con éxito!'); window.location.href='/login';">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" placeholder="Tu nombre" required>
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" placeholder="tu@email.com" required>
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" placeholder="Mínimo 8 caracteres" required>
                </div>
                <button type="submit" class="btn-red" style="width: 100%; margin-top: 15px; justify-content: center;">Crear mi cuenta</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>