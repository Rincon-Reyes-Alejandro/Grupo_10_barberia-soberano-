<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 600px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Panel de Usuario</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 20px 0; font-weight: normal;">Mi Perfil.</h2>
            
            <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
                <div class="logo-circle" style="width: 60px; height: 60px; font-size: 1.5rem;">S</div>
                <div>
                    <!-- Usamos EJS para mostrar el nombre y correo dinámico -->
                    <h3 style="font-size: 1.2rem; margin-bottom: 5px;"><%= usuario.nombre %></h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem;"><%= usuario.email %></p>
                </div>
            </div>

            <form onsubmit="event.preventDefault(); alert('¡Perfil actualizado con éxito!');">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" value="<%= usuario.nombre %>" required>
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" value="<%= usuario.email %>" required>
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="tel" value="<%= usuario.telefono %>">
                </div>
                <div class="form-group">
                    <label>Dirección de Envío</label>
                    <input type="text" value="<%= usuario.direccion %>">
                </div>

                <div style="display: flex; gap: 15px; margin-top: 25px;">
                    <button type="submit" class="btn-red" style="flex: 1; justify-content: center;">Guardar Cambios</button>
                    <a href="/" style="flex: 1; display: flex; align-items: center; justify-content: center; text-decoration: none; border: 1px solid var(--border-color); color: var(--text-dark); border-radius: 4px; font-size: 0.9rem;">Cerrar Sesión</a>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>