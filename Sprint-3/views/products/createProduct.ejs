<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 600px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Panel de Administración</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 30px 0; font-weight: normal;">Crear Nuevo Producto</h2>

            <form action="/products" method="POST">
                <div class="form-group">
                    <label>Nombre del Producto (name)</label>
                    <input type="text" name="name" placeholder="Ej: Aceite de Barba Premium" required>
                </div>

                <div class="form-group">
                    <label>Descripción (description)</label>
                    <input type="text" name="description" placeholder="Breve descripción de los beneficios" required>
                </div>

                <div class="form-group">
                    <label>Imagen (image - Nombre del archivo)</label>
                    <input type="text" name="image" placeholder="ej: producto-nuevo.jpg" required>
                </div>

                <div class="form-group">
                    <label>Categoría (category)</label>
                    <select name="category" required>
                        <option value="" disabled selected>Selecciona una categoría</option>
                        <option value="afeitado">Afeitado</option>
                        <option value="barba">Barba</option>
                        <option value="cabello">Cabello</option>
                        <option value="herramientas">Herramientas</option>
                        <option value="edicion-especial">Edición Especial</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Colores / Tamaños (colors / attributes)</label>
                    <input type="text" name="colors" placeholder="Ej: Negro, Madera natural, etc.">
                </div>

                <div class="form-group">
                    <label>Precio (€)</label>
                    <input type="number" name="price" placeholder="25" required>
                </div>

                <button type="submit" class="btn-red" style="width: 100%; margin-top: 20px; justify-content: center;">Guardar Producto</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>