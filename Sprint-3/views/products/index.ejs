                        <a href="/products/edit" style="font-size: 0.8rem; background-color: #333; color: #fff; padding: 5px 12px; border-radius: 4px; text-decoration: none;">⚙️ Editar producto</a>
                    </div>
                <% } %>
            </div>

            <!-- Producto 3 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-cuchillas.jpg" alt="Cuchillas Clásicas" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Cuchillas Clásicas', 9)">🛒 Añadir</button>
                </div>
                <span class="product-category">Afeitado</span>
                <div class="product-name-price">
                    <h4>Cuchillas Clásicas</h4>
                    <span>9 €</span>
                </div>
