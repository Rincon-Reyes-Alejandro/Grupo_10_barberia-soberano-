            </div>
            <div>
                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
                    <a href="/products/create" class="btn-red" style="text-decoration: none; padding: 10px 20px; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 8px;">+ Nuevo Producto</a>
                <% } %>
            </div>
        </div>

        <div class="products-grid">
            <!-- Producto 1 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-crema.jpg" alt="Crema de Afeitado" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Crema de Afeitado N·01', 10)">🛒 Añadir</button>
                </div>
                <span class="product-category">Afeitado</span>
                <div class="product-name-price">
                    <h4>Crema de Afeitado N·01</h4>
