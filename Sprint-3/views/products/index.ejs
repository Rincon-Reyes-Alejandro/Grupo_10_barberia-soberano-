                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Cera Soberana', 19)">🛒 Añadir</button>
                </div>
                <span class="product-category">Cabello</span>
                <div class="product-name-price">
                    <h4>Cera Soberana</h4>
                    <span>19 €</span>
                </div>
                <p class="product-desc">Textura flexible, acabado natural y control duradero.</p>

                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
                    <div style="margin-top: 12px; text-align: right;">
                        <a href="/products/edit" style="font-size: 0.8rem; background-color: #333; color: #fff; padding: 5px 12px; border-radius: 4px; text-decoration: none;">⚙️ Editar producto</a>
                    </div>
                <% } %>
            </div>

            <!-- Producto 6 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-aceite.jpg" alt="Aceite de Barba" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Aceite de Barba N·03', 22)">🛒 Añadir</button>
                </div>
                <span class="product-category">Barba</span>
                <div class="product-name-price">
                    <h4>Aceite de Barba N·03</h4>
                    <span>22 €</span>
                </div>
                <p class="product-desc">Argán, jojoba y cedro para nutrir sin engrasar.</p>

                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
                    <div style="margin-top: 12px; text-align: right;">
                        <a href="/products/edit" style="font-size: 0.8rem; background-color: #333; color: #fff; padding: 5px 12px; border-radius: 4px; text-decoration: none;">⚙️ Editar producto</a>
                    </div>
                <% } %>
            </div>

            <!-- Producto 7 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-balsamo.jpg" alt="Bálsamo After Shave" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Bálsamo After Shave', 21)">🛒 Añadir</button>
                </div>
                <span class="product-category">Afeitado</span>
                <div class="product-name-price">
                    <h4>Bálsamo After Shave</h4>
                    <span>21 €</span>
                </div>
                <p class="product-desc">Calma, hidrata y refresca después del afeitado.</p>

                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
                    <div style="margin-top: 12px; text-align: right;">
                        <a href="/products/edit" style="font-size: 0.8rem; background-color: #333; color: #fff; padding: 5px 12px; border-radius: 4px; text-decoration: none;">⚙️ Editar producto</a>
                    </div>
                <% } %>
            </div>

            <!-- Producto 8 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-kit.jpg" alt="Kit Ritual Completo" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Kit Ritual Completo', 58)">🛒 Añadir</button>
                </div>
                <span class="product-category">Edición Especial</span>
                <div class="product-name-price">
                    <h4>Kit Ritual Completo</h4>
                    <span>58 €</span>
                </div>
                <p class="product-desc">Crema, aceite, cera y peine en estuche de regalo.</p>

                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
