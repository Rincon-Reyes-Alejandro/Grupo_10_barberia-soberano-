                    </div>
                <% } %>
            </div>

            <!-- Producto 4 -->
            <div class="product-card">
                <div class="product-img">
                    <img src="/images/producto-gel.jpg" alt="Gel Fijador Mate" style="width:100%; height:100%; object-fit:cover;">
                    <button class="btn-add-overlay" onclick="agregarAlCarrito('Gel Fijador Mate', 18)">🛒 Añadir</button>
                </div>
                <span class="product-category">Cabello</span>
                <div class="product-name-price">
                    <h4>Gel Fijador Mate</h4>
                    <span>18 €</span>
                </div>
                <p class="product-desc">Fijación media sin residuos ni efecto mojado.</p>

                <% if (typeof usuario !== 'undefined' && usuario.esAdmin) { %>
