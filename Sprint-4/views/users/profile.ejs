<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 600px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Panel de Usuario</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 20px 0; font-weight: normal;">Mi Perfil.</h2>
            
            <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
                <div class="logo-circle" style="width: 60px; height: 60px; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; background: #333; color: #fff; border-radius: 50%;">
                    <%= usuario.nombre ? usuario.nombre.charAt(0).toUpperCase() : 'S' %>
                </div>
                <div>
                    <!-- Usamos EJS para mostrar el nombre y correo dinámico -->
                    <h3 style="font-size: 1.2rem; margin-bottom: 5px;"><%= usuario.nombre %></h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem;"><%= usuario.email %></p>
                </div>
            </div>

            <!-- Formulario conectado con método PUT para actualizar teléfono y dirección -->
            <form action="/profile/update?_method=PUT" method="POST">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" value="<%= usuario.nombre %>" disabled style="background-color: #f5f5f5;">
                </div>
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" value="<%= usuario.email %>" disabled style="background-color: #f5f5f5;">
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="tel" name="phone" value="<%= usuario.phone || '' %>" placeholder="Ingresa tu número de teléfono">
                </div>
                <div class="form-group">
                    <label>Dirección de Envío</label>
                    <input type="text" name="address" value="<%= usuario.address || '' %>" placeholder="Ingresa tu dirección">
                </div>

                <!-- Botón para guardar los cambios (Centrado) -->
                <button type="submit" class="btn-red" style="width: 100%; padding: 12px; margin-top: 10px; border: none; cursor: pointer; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; text-align: center; display: block;">
                    Guardar Cambios
                </button>
            </form>

            <div class="profile-actions" style="margin-top: 20px; text-align: center;">
                <a href="/logout" class="btn-red" style="text-decoration: none; padding: 12px 20px; display: block; background-color: #222; color: white; border-radius: 4px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>