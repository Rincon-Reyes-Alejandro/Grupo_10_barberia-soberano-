<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 600px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Panel de Administración</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 30px 0; font-weight: normal;">Crear Nuevo Producto</h2>

            <form action="/products" method="POST">
                <div class="form-group">
                    <label>Nombre del Producto</label>
                    <input type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    <textarea name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label>Precio (€)</label>
                    <input type="number" name="price" required>
                </div>
                <div class="form-group">
                    <label>Categoría</label>
                    <input type="text" name="category" required>
                </div>
                <button type="submit" class="btn-red" style="width: 100%; margin-top: 15px; justify-content: center;">Guardar Producto</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>