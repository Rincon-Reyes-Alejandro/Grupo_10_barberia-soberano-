<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 600px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Panel de Administración</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 30px 0; font-weight: normal;">Editar Producto</h2>

            <form action="/products/<%= product.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Nombre del Producto</label>
                    <input type="text" name="name" value="<%= locals.oldData && oldData.name ? oldData.name : product.name %>" required>
                    <% if (locals.errors && errors.name) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.name.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Descripción</label>
                    <textarea name="description" required><%= locals.oldData && oldData.description ? oldData.description : product.description %></textarea>
                    <% if (locals.errors && errors.description) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.description.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Precio ($)</label>
                    <input type="number" name="price" value="<%= locals.oldData && oldData.price ? oldData.price : product.price %>" required>
                    <% if (locals.errors && errors.price) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.price.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Categoría</label>
                    <select name="category" id="category" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;">
                        <% categories.forEach(cat => { %>
                            <!-- Evalúa si hay error para dejar seleccionada la opción intentada, sino deja la de la base de datos -->
                            <option value="<%= cat.id %>" <%= (locals.oldData && oldData.category == cat.id) || (!locals.oldData && product.category_id == cat.id) ? 'selected' : '' %>>
                                <%= cat.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Imagen del Producto</label>
                    <input type="file" name="image" accept="image/*">
                    <small style="color: gray;">Imagen actual: <%= product.image %></small>
                    <% if (locals.errors && errors.image) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.image.msg %></div>
                    <% } %>
                </div>
                
                <button type="submit" class="btn-red" style="width: 100%; margin-top: 15px;">Modificar Producto</button>
            </form>

            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este producto?');" style="background: var(--bg-red); color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; margin-top: 10px; width: 100%;">🗑️ Eliminar</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <!-- Conectamos nuestro script de validación Front-end para Productos -->
    <script src="/js/productValidation.js"></script>

</body>
</html>