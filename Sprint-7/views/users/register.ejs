<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 500px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Acceso Privado</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 20px 0; font-weight: normal;">Únete al distrito.</h2>
            
            <div style="display: flex; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                <a href="/login" style="color: var(--text-muted); text-decoration: none;">INICIAR SESIÓN</a>
                <span style="font-weight: bold; border-bottom: 2px solid var(--bg-red); padding-bottom: 11px;">REGÍSTRATE</span>
            </div>

            <!-- Mostramos mensaje de error general (ej. si el correo ya existe pero no viene de express-validator) -->
            <% if (locals.error) { %>
                <div style="color: #fff; background-color: var(--bg-red); padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 0.9rem;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="firstName" value="<%= locals.oldData && oldData.firstName ? oldData.firstName : '' %>" required>
                    <% if (locals.errors && errors.firstName) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.firstName.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Apellido</label>
                    <input type="text" name="lastName" value="<%= locals.oldData && oldData.lastName ? oldData.lastName : '' %>" required>
                    <% if (locals.errors && errors.lastName) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.lastName.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="email" value="<%= locals.oldData && oldData.email ? oldData.email : '' %>" required>
                    <% if (locals.errors && errors.email) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.email.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" name="password" required>
                    <% if (locals.errors && errors.password) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.password.msg %></div>
                    <% } %>
                </div>
                
                <div class="form-group">
                    <label>Foto de Perfil:</label>
                    <input type="file" name="image" accept="image/*">
                    <% if (locals.errors && errors.image) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.image.msg %></div>
                    <% } %>
                </div>
                
                <button type="submit" class="btn-red" style="width: 100%; margin-top: 15px;">Registrarse</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <!-- Conectamos nuestro script de validación Front-end -->
    <script src="/js/registerValidation.js"></script>

</body>
</html>