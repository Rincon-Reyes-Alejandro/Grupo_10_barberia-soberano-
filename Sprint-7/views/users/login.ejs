<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="light-section" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="modal-box" style="max-width: 500px; width: 100%; box-shadow: none; border: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; letter-spacing: 2px; color: var(--bg-red); text-transform: uppercase;">— Acceso Privado</span>
            <h2 style="font-size: 2.2rem; margin: 10px 0 20px 0; font-weight: normal;">Bienvenido de nuevo.</h2>
            
            <div style="display: flex; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                <span style="font-weight: bold; border-bottom: 2px solid var(--bg-red); padding-bottom: 11px;">INICIAR SESIÓN</span>
                <a href="/register" style="color: var(--text-muted); text-decoration: none;">REGÍSTRATE</a>
            </div>

            <!-- Formulario conectado mediante POST para evaluar credenciales -->
            <form action="/login" method="POST">
                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <!-- Recuperamos el valor del email si el usuario se equivocó -->
                    <input type="text" name="email" placeholder="ej: admin o tu@email.com" value="<%= locals.oldData && oldData.email ? oldData.email : '' %>" required>
                    <!-- Error de express-validator -->
                    <% if (locals.errors && errors.email) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.email.msg %></div>
                    <% } %>
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" name="password" placeholder="Tu contraseña" required>
                    <!-- Error de express-validator -->
                    <% if (locals.errors && errors.password) { %>
                        <div style="color: #d9534f; font-size: 0.85rem; margin-top: 5px; font-weight: bold;"><%= errors.password.msg %></div>
                    <% } %>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-size: 0.85rem;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-dark);">
                        <input type="checkbox" style="width: auto; margin: 0;"> Recuérdame
                    </label>
                    <a href="#" onclick="alert('Se ha enviado un enlace de recuperación a tu correo electrónico.'); return false;" style="color: var(--bg-red); text-decoration: none;">¿Has olvidado tu contraseña?</a>
                </div>
                
                <!-- Error general (ej: contraseña incorrecta o correo no existe) -->
                <% if (typeof error !== 'undefined') { %>
                    <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border: 1px solid #f5c6cb; border-radius: 4px; margin-bottom: 20px; text-align: center;">
                        <%= error %>
                    </div>
                <% } %>

                <button type="submit" class="btn-red" style="width: 100%; margin-top: 5px; justify-content: center;">Entrar</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
    
    <!-- Conectamos nuestro script de validación Front-end para el Login -->
    <script src="/js/loginValidation.js"></script>

</body>
</html>